# Local default: SQLite (no Docker). For Postgres: postgresql+psycopg://newsletter:newsletter@localhost:5432/newsletter_builder
DATABASE_URL=sqlite:///./newsletter_builder.db

# Public address people open in a browser. Review links use this exact address.
# On a server: https://newsletters.example.com
WEB_APP_URL=http://localhost:3000
WEB_PORT=3000

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=uploads

# Email service used to send review links to the lead.
# Any SMTP provider works (for example your host, Fastmail, or a transactional service).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

# Demo auth (v1)
DEMO_BADER_TOKEN=bader-demo-token
DEMO_LEAD_TOKEN=lead-demo-token

# Workspace defaults
DEFAULT_WORKSPACE_PLAN=premium

# Slack (optional — demo mode logs to console if unset)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_LEAD_CHANNEL=#newsletter-reviews

# Mailchimp (optional — demo mode returns mock editor URL if unset)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_LIST_ID=
MAILCHIMP_FROM_NAME=Newsletter
MAILCHIMP_REPLY_TO=noreply@example.com

# AI (optional — mock text if unset; premium required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
